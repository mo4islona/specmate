# ─── database ────────────────────────────────────────────────────────────────
POSTGRES_USER=specmate
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=specmate
POSTGRES_PORT=5432
DATABASE_URL=postgres://specmate:change-me-in-production@localhost:5432/specmate

# ─── services ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
ORCHESTRATOR_PORT=4100
WEB_PORT=5173

# Single-owner auth (§9.3). Required when NODE_ENV=production.
# Generate: openssl rand -base64 32
SPECMATE_PASSWORD=

# ─── workspaces ──────────────────────────────────────────────────────────────
# Repository mirrors and per-task worktrees.
#
# Under Compose this MUST be one absolute path that exists on the host: it is
# bind-mounted at the same path inside the orchestrator, and the orchestrator
# passes it to the container runtime when it mounts a task's worktree into a
# runner. The runtime resolves that path on the host, so if the two sides
# disagree the runner mounts an empty directory and the agent reports an empty
# repository. Startup refuses to proceed when the probe does not match.
#
# The directory must be writable by uid 10001 (the orchestrator and the runner
# share that uid so they can write the same worktree):
#   sudo mkdir -p /var/lib/specmate/workspaces && sudo chown -R 10001:10001 /var/lib/specmate
WORKSPACE_ROOT=/var/lib/specmate/workspaces
GIT_AUTHOR_NAME=SpecMate
GIT_AUTHOR_EMAIL=specmate@localhost
# Read-only key for target repositories. Leave empty for public or local
# origins; when set, Compose mounts this file into the orchestrator.
REPO_SSH_KEY_PATH=

# ─── agent runner ────────────────────────────────────────────────────────────
# Where a stage runs. `docker` starts one container per stage and discards it;
# `local` runs the provider as a child of the orchestrator and is for
# development only — in production the process refuses to start with it.
RUNNER_BACKEND=local
# Pin the provider CLI. Required to build the runner image; a stage records the
# version it ran with, so an unpinned CLI is an unpinned agent.
CLAUDE_CODE_VERSION=
RUNNER_IMAGE=specmate/runner-claude:local
RUNNER_MODEL=claude-opus-5
RUNNER_AUTH_VOLUME=specmate_claude-auth
RUNNER_CPUS=2
RUNNER_MEMORY=4g
STAGE_TIMEOUT_MS=1800000
# Variable names (comma-separated) forwarded from the orchestrator into a
# stage. Leave empty to use the session stored in the auth volume; set
# ANTHROPIC_API_KEY here to bill through the API instead.
RUNNER_FORWARD_ENV=
