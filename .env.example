# ─── database ────────────────────────────────────────────────────────────────
POSTGRES_USER=specmate
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=specmate
POSTGRES_PORT=5432
DATABASE_URL=postgres://specmate:change-me-in-production@localhost:5432/specmate

# ─── services ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
ORCHESTRATOR_PORT=4100
WEB_PORT=5173

# Single-owner auth (§9.3). Required when NODE_ENV=production.
# Generate: openssl rand -base64 32
SPECMATE_PASSWORD=

# ─── workspaces ──────────────────────────────────────────────────────────────
# Repository mirrors and per-task worktrees.
#
# Under Compose this MUST be one absolute path that exists on the host: it is
# bind-mounted at the same path inside the services that manage task workspaces, and the orchestrator
# passes it to the container runtime when it mounts a task's worktree into a
# runner. The runtime resolves that path on the host, so if the two sides
# disagree the runner mounts an empty directory and the agent reports an empty
# repository. Startup refuses to proceed when the probe does not match.
#
# The directory must be writable by uid 10001 (the API, orchestrator, and runner
# share that uid so gate cleanup and stage execution can touch the same worktree):
#   sudo mkdir -p /var/lib/specmate/workspaces && sudo chown -R 10001:10001 /var/lib/specmate
WORKSPACE_ROOT=/var/lib/specmate/workspaces
GIT_AUTHOR_NAME=SpecMate
GIT_AUTHOR_EMAIL=specmate@localhost
# Public GitHub OAuth App client id. Access and refresh tokens are stored in
# app_settings by `github-login`, never in this file.
GITHUB_APP_CLIENT_ID=

# ─── agent runner ────────────────────────────────────────────────────────────
# Where a stage runs. `docker` starts one container per stage and discards it;
# `local` runs the provider as a child of the orchestrator and is for
# development only — in production the process refuses to start with it.
RUNNER_BACKEND=local
# Pin every provider CLI and the toolchain manager. All are required to build
# the runner image; floating versions would make stage environments drift.
CLAUDE_CODE_VERSION=
CODEX_VERSION=
MISE_VERSION=
RUNNER_IMAGE=specmate/runner-universal:local
RUNNER_TOOLCHAINS_VOLUME=specmate_toolchains
RUNNER_CPUS=2
RUNNER_MEMORY=4g
# Wall clock one attempt gets, from spawn; activity does not extend it.
STAGE_TIMEOUT_MS=10800000

# ─── providers ───────────────────────────────────────────────────────────────
# Exactly the providers this deployment runs, comma-separated. Provider binding
# selects from these, and cross-provider checking has an alternative to pick
# only when there is more than one — with a single entry every stage runs it.
#
# Empty on purpose: install.sh asks which agents to run and writes the answer,
# and then asks only for the credentials those agents need. Anything reading
# this unset falls back to claude-code.
AVAILABLE_PROVIDERS=

# Each provider names its CLI and keeps its own stored session, so a stage
# reaches the credential of the provider it runs under and no other. The
# forward list is variable *names*: values are read from the orchestrator's own
# environment and never placed on a command line.
CLAUDE_CODE_CLI=claude
CLAUDE_CODE_AUTH_VOLUME=specmate_claude-auth
CLAUDE_CODE_FORWARD_ENV=CLAUDE_CODE_OAUTH_TOKEN
CODEX_CLI=codex
CODEX_AUTH_VOLUME=specmate_codex-auth
CODEX_FORWARD_ENV=

# ─── claude access ───────────────────────────────────────────────────────────
# How a stage authenticates to Claude. The default is a long-lived token minted
# from your own Claude subscription:
#
#   claude setup-token
#
# Run it anywhere you are already signed in — your laptop is fine — and paste
# the result here. It survives a lost auth volume and needs no terminal on the
# server, unlike an interactive `docker compose run --rm runner claude` login.
#
# This is a personal seat. See docs/install.md before pointing it at anything
# but your own orchestrator.
CLAUDE_CODE_OAUTH_TOKEN=

# ─── codex access ────────────────────────────────────────────────────────────
# Only needed once `codex` is in AVAILABLE_PROVIDERS. The CLI authenticates from
# its own session file and ignores a key in its environment, so both ways write
# the auth volume — which is what a stage reads:
#
#   docker compose run --rm runner-codex codex login --device-auth
#   printf %s "$key" | docker compose run --rm -T runner-codex codex login --with-api-key
#
# install.sh runs either for you. A key given to it is kept below as well, so a
# lost auth volume can be refilled without asking for it again.
CODEX_API_KEY=

# ─── orchestrator loop ───────────────────────────────────────────────────────
# How often the loop polls Postgres for runnable tasks. Stages run for minutes,
# so seconds of poll latency are invisible.
TICK_INTERVAL_MS=5000
# Stages in flight at once, across tasks. A task never runs more than one stage
# at a time regardless of this value.
STAGE_CONCURRENCY=1
# Dispatches per stage before the task moves to `failed` naming the stage. The
# runner's own single result-retry happens inside a dispatch and is separate.
STAGE_ATTEMPT_CAP=2
