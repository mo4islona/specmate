{
  "name": "specmate",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test apps/api apps/orchestrator packages && bun run --cwd apps/web test",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "spec:validate": "openspec validate --all --strict",
    "spec:lint": "bun scripts/lint-spec-ids.ts",
    "spec:next-id": "bun scripts/lint-spec-ids.ts --next",
    "spec:list": "openspec list",
    "ci": "bun run check && bun run typecheck && bun run test && bun run spec:validate && bun run spec:lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@fission-ai/openspec": "^1.9.0",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
