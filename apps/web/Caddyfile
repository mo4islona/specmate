{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# Same-origin API so the SPA needs no CORS and no separate host.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:4000}
	}
	handle /readyz {
		reverse_proxy {$API_UPSTREAM:api:4000}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
